<ResourceDictionary
    x:Class="NINA.Plugin.NightSage.Dockables.NightSageDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="NINA.Plugin.NightSage.Dockables.NightSageDockable_Dockable">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" FontSize="17" FontWeight="SemiBold" Text="NightSage"/>
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,2"/>
                </DockPanel>
                <Border BorderThickness="1" Padding="7" Margin="0,0,0,8">
                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Active setup"/><TextBlock TextWrapping="Wrap" Text="{Binding SetupSummary}"/><TextBlock Margin="0,4,0,0" Text="{Binding TargetSchedulerStatus}"/></StackPanel>
                </Border>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Mode"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AutonomyModes}" SelectedItem="{Binding AutonomyMode}"/>
                </Grid>
                <TextBlock FontWeight="SemiBold" Text="Plan a target"/>
                <TextBox Margin="0,4,0,4" Text="{Binding TargetQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Examples: M1, IC 434, NGC 6888"/>
                <TextBox Margin="0,0,0,6" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding UserPreferences, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional: RGB stars, maximum sub length, scientific goal, desired total time, etc."/>
                <Button Content="Analyze target" Command="{Binding AnalyzeCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                <Separator Margin="0,10"/>
                <DockPanel><TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Text="Discover — next 7 days"/><Button DockPanel.Dock="Right" Content="Find targets" Command="{Binding DiscoverCommand}" Padding="10,4"/></DockPanel>
                <ListBox Margin="0,5,0,5" MinHeight="110" MaxHeight="220" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="DisplayLine"/>
                <Button Content="Build plan for selected target" Command="{Binding PlanSelectedCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                <Separator Margin="0,10"/>
                <DockPanel><TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Plan preview"/><Button DockPanel.Dock="Right" Content="Create in Target Scheduler" Command="{Binding CreateCommand}" Padding="10,4"/></DockPanel>
                <TextBlock Margin="0,5,0,5" TextWrapping="Wrap" Text="{Binding PlanSummary}"/>
                <ItemsControl ItemsSource="{Binding CurrentPlan.Exposures}">
                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="0,1,0,0" Padding="3"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Filter}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SubSeconds, StringFormat={}{0:0}s subs}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DesiredCount, StringFormat={}{0} frames}"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalMinutes, StringFormat={}{0:0} min total}"/>
                    </Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,10,0,0" Padding="6" BorderThickness="1"><TextBlock TextWrapping="Wrap" Text="{Binding Status}"/></Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <GeometryGroup x:Key="NightSage_Icon">
        <PathGeometry Figures="M12,2 L14.4,8.1 L21,8.5 L16,12.8 L17.8,19.2 L12,15.7 L6.2,19.2 L8,12.8 L3,8.5 L9.6,8.1 Z"/>
        <EllipseGeometry Center="12,12" RadiusX="2.2" RadiusY="2.2"/>
    </GeometryGroup>
</ResourceDictionary>
