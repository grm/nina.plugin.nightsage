<ResourceDictionary
    x:Class="NINA.Plugin.NightSage.Dockables.NightSageDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="NightSage_Workspace">
        <StackPanel Margin="2">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Active setup"/>
                    <TextBlock TextWrapping="Wrap" Text="{Binding SetupSummary}"/>
                    <TextBlock Margin="0,3,0,0" Text="{Binding TargetSchedulerStatus}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,2" MinWidth="70"
                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Text="Autonomy mode"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AutonomyModes}" SelectedItem="{Binding AutonomyMode}"
                          ToolTip="Preview: never write. Create: build then create after confirmation when needed. Autopilot: discover, plan and create."/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Text="Integration ambition"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding IntegrationAmbitions}" SelectedItem="{Binding IntegrationAmbition}"
                          ToolTip="Quick: favor ~10h or less. Balanced: short targets remain valid, allow moderate projects around 20h. Deep: no time penalty; short targets remain equally eligible."/>
            </Grid>

            <Expander Header="Plan a target" IsExpanded="True" Margin="0,4,0,0">
                <StackPanel Margin="8,5,4,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,8,0" Text="Target name or catalog ID"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,5" Text="{Binding TargetQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Examples: M1, IC 434, NGC 6888"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,0" Text="Optional planning instructions"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,5" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding UserPreferences, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Examples: HDR core with 15s/60s exposures; short RGB stars; preferred palette; desired total integration."/>
                    </Grid>
                    <Button Content="Analyze target" Command="{Binding AnalyzeCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <Expander Header="Discover targets" IsExpanded="True" Margin="0,6,0,0">
                <StackPanel Margin="8,5,4,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.75"
                                   Text="Recommendations for the next 7 days, ranked for this setup and ambition."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Searching…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscovering}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Width="82" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscovering}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Button Content="Find targets" Command="{Binding DiscoverCommand}" Padding="10,3"
                                    MinWidth="90" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Expander Header="Target types &amp; result limit" IsExpanded="False" Margin="0,7,0,5">
                        <StackPanel Margin="10,5,4,6">
                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Emission / HII"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverEmissionNebulae}"/>
                                </Grid>
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Reflection / dark nebula"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverReflectionDarkNebulae}"/>
                                </Grid>
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Galaxy"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverGalaxies}"/>
                                </Grid>
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Planetary nebula"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverPlanetaryNebulae}"/>
                                </Grid>
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="SNR / WR shell"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverSnrWrShells}"/>
                                </Grid>
                                <Grid Margin="0,2,22,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Cluster / star field"/>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DiscoverClustersStarFields}"/>
                                </Grid>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock VerticalAlignment="Center" Text="Maximum results"/>
                                <TextBox Width="55" Margin="10,0,0,0" Text="{Binding DiscoveryResultLimit, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="1 to 30. NightSage first preserves category diversity, then fills remaining slots with the strongest alternatives."/>
                                <TextBlock Margin="8,2,0,0" Opacity="0.7" Text="(1–30; default 12)"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <ListBox Margin="0,3,0,6" MinHeight="130" MaxHeight="320"
                             Background="Transparent" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="7,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayLine}" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Build plan for selected target" Command="{Binding PlanSelectedCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <Expander Header="Plan preview" IsExpanded="True" Margin="0,6,0,0">
                <StackPanel Margin="8,5,4,6">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding PlanSummary}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="Frame target" Command="{Binding LoadCurrentPlanIntoFramingCommand}" Padding="10,4" Margin="0,0,6,0"
                                    ToolTip="Open the embedded N.I.N.A. Framing Assistant and load this target/image immediately."/>
                            <Button Content="Create in Target Scheduler" Command="{Binding CreateCommand}" Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontWeight="SemiBold" Text="Exposure template mapping" Margin="0,10,0,2"/>
                    <TextBlock Opacity="0.72" TextWrapping="Wrap" Margin="0,0,0,5"
                               Text="Each selector shows whether NightSage will use an existing template or use it as the base for a derived exposure length. You can choose another base."/>

                    <Grid Margin="4,2,4,3" Opacity="0.72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/><ColumnDefinition Width="85"/><ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filter"/>
                        <TextBlock Grid.Column="1" Text="Sub"/>
                        <TextBlock Grid.Column="2" Text="Frames"/>
                        <TextBlock Grid.Column="3" Text="Template"/>
                        <TextBlock Grid.Column="4" Text="Integration" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TemplateChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/><ColumnDefinition Width="85"/><ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Exposure.Filter}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Exposure.SubSeconds, StringFormat={}{0:0.#}s}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Exposure.DesiredCount, StringFormat={}{0} frames}"/>
                                        <ComboBox Grid.Column="3" MinWidth="260" Margin="0,0,10,0"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayLabel"/>
                                        <TextBlock Grid.Column="4" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding Exposure.IntegrationDisplay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,8,0,0" Padding="7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Integration summary"/>
                            <TextBlock Margin="0,3,0,0" Opacity="0.75" Text="Per-panel filter integration"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding CurrentPlan.FilterIntegrationSummary}"/>
                            <DockPanel Margin="0,5,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Integration per panel"/>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" FontWeight="SemiBold" Text="{Binding CurrentPlan.IntegrationPerPanelDisplay}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Project total"/>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" FontWeight="Bold" Text="{Binding CurrentPlan.TotalIntegrationDisplay}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <Border Margin="0,9,0,0" Padding="6" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Text="{Binding Status}"/>
            </Border>
        </StackPanel>
    </DataTemplate>

    <GeometryGroup x:Key="NightSage_Icon">
        <PathGeometry Figures="M12,2 L14.4,8.1 L21,8.5 L16,12.8 L17.8,19.2 L12,15.7 L6.2,19.2 L8,12.8 L3,8.5 L9.6,8.1 Z"/>
        <EllipseGeometry Center="12,12" RadiusX="2.2" RadiusY="2.2"/>
    </GeometryGroup>
</ResourceDictionary>
