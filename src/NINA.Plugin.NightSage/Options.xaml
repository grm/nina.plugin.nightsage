<ResourceDictionary
    x:Class="NINA.Plugin.NightSage.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="NightSage_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8" MaxWidth="760">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="NightSage — AI planning" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="NightSage sends setup/target planning context to the selected provider. API keys are encrypted locally for the current Windows user."/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5" Text="Provider"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="4" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5" Text="Model"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5" Text="Endpoint override"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank for the provider default. Required for many OpenAI-compatible/local endpoints."/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5" Text="API key"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" Margin="4" x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,5" Text="Default autonomy"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="4" ItemsSource="{Binding AutonomyModes}" SelectedItem="{Binding AutonomyMode}"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,5" Text="Minimum altitude"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="4" Text="{Binding MinimumAltitudeDegrees, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,5" Text="Target Scheduler"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="4">
                        <CheckBox IsChecked="{Binding ActivateCreatedProjects}" Content="Create projects Active (unchecked = Draft)"/>
                        <CheckBox IsChecked="{Binding IncludeExistingTargets}" Content="Use current Target Scheduler targets during discovery"/>
                    </StackPanel>
                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,5" Text="Connection"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="4">
                        <Button Content="Test provider" Command="{Binding TestProviderCommand}" Padding="12,4"/>
                        <TextBlock Margin="12,5,0,0" Text="{Binding ProviderTestStatus}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="Target Scheduler note for OSC/no filter wheel: Target Scheduler requires a named filter in the N.I.N.A. filter configuration. Configure a dummy filter such as OSC/LP; the physical wheel can remain disconnected."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
